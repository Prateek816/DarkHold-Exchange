# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection String (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/darkhold_exchange?schema=public"

# Session / Auth Security
SESSION_SECRET="darkhold-exchange-secure-session-key-dev-only"
SESSION_EXPIRY_HOURS=24
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Matching Engine Simulation Settings
MATCHING_SIM_ENABLED=true

{
  "name": "S01-limit-buy-rests",
  "description": "A resting limit buy produces OrderAccepted only.",
  "engine_epoch": "e-test0001",
  "steps": [
    {
      "ts": 1000,
      "command": {
        "type": "ConfigureAsset",
        "asset": "TEST-A",
        "tick_size": 1,
        "min_qty": 1,
        "max_qty": 1000,
        "collar_max_price": null,
        "status": "ACTIVE"
      },
      "expect_reply": {
        "status": "OK",
        "seq": 1,
        "last_seq": 1,
        "engine_epoch": "e-test0001",
        "duplicate": false,
        "asset": "TEST-A"
      },
      "expect_events": [
        {
          "type": "AssetConfigured",
          "engine_epoch": "e-test0001",
          "seq": 1,
          "ts": 1000,
          "asset": "TEST-A",
          "tick_size": 1,
          "min_qty": 1,
          "max_qty": 1000,
          "collar_max_price": null,
          "status": "ACTIVE"
        }
      ]
    },
    {
      "ts": 1001,
      "command": {
        "type": "SubmitOrder",
        "order_id": "a0000000-0000-4000-8000-000000000001",
        "asset": "TEST-A",
        "user_id": "U1",
        "side": "BUY",
        "order_type": "LIMIT",
        "tif": "GTC",
        "qty": 5,
        "price": 100
      },
      "expect_reply": {
        "status": "ACCEPTED",
        "seq": 2,
        "last_seq": 2,
        "engine_epoch": "e-test0001",
        "duplicate": false,
        "order_id": "a0000000-0000-4000-8000-000000000001"
      },
      "expect_events": [
        {
          "type": "OrderAccepted",
          "engine_epoch": "e-test0001",
          "seq": 2,
          "ts": 1001,
          "asset": "TEST-A",
          "order_id": "a0000000-0000-4000-8000-000000000001",
          "user_id": "U1",
          "side": "BUY",
          "order_type": "LIMIT",
          "tif": "GTC",
          "price": 100,
          "qty": 5
        }
      ],
      "expect_book": {
        "bids": [
          {
            "price": 100,
            "qty": 5,
            "orders": 1
          }
        ],
        "asks": []
      }
    }
  ]
}
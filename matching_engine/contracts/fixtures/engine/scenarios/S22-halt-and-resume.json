{
  "name": "S22-halt-and-resume",
  "description": "Halt rejects submits, allows cancel.",
  "engine_epoch": "e-test0001",
  "steps": [
    {
      "ts": 1000,
      "command": {
        "type": "ConfigureAsset",
        "asset": "TEST-A",
        "tick_size": 1,
        "min_qty": 1,
        "max_qty": 1000,
        "collar_max_price": null,
        "status": "ACTIVE"
      },
      "expect_reply": {
        "status": "OK",
        "seq": 1,
        "last_seq": 1,
        "engine_epoch": "e-test0001",
        "duplicate": false,
        "asset": "TEST-A"
      },
      "expect_events": [
        {
          "type": "AssetConfigured",
          "engine_epoch": "e-test0001",
          "seq": 1,
          "ts": 1000,
          "asset": "TEST-A",
          "tick_size": 1,
          "min_qty": 1,
          "max_qty": 1000,
          "collar_max_price": null,
          "status": "ACTIVE"
        }
      ]
    },
    {
      "ts": 1001,
      "command": {
        "type": "SubmitOrder",
        "order_id": "a0000000-0000-4000-8000-000000000001",
        "asset": "TEST-A",
        "user_id": "U1",
        "side": "BUY",
        "order_type": "LIMIT",
        "tif": "GTC",
        "qty": 5,
        "price": 100
      },
      "expect_reply": {
        "status": "ACCEPTED",
        "seq": 2,
        "last_seq": 2,
        "engine_epoch": "e-test0001",
        "duplicate": false,
        "order_id": "a0000000-0000-4000-8000-000000000001"
      },
      "expect_events": [
        {
          "type": "OrderAccepted",
          "engine_epoch": "e-test0001",
          "seq": 2,
          "ts": 1001,
          "asset": "TEST-A",
          "order_id": "a0000000-0000-4000-8000-000000000001",
          "user_id": "U1",
          "side": "BUY",
          "order_type": "LIMIT",
          "tif": "GTC",
          "price": 100,
          "qty": 5
        }
      ]
    },
    {
      "ts": 1002,
      "command": {
        "type": "HaltAsset",
        "asset": "TEST-A"
      },
      "expect_reply": {
        "status": "OK",
        "seq": 3,
        "last_seq": 3,
        "engine_epoch": "e-test0001",
        "duplicate": false,
        "asset": "TEST-A"
      },
      "expect_events": [
        {
          "type": "AssetHalted",
          "engine_epoch": "e-test0001",
          "seq": 3,
          "ts": 1002,
          "asset": "TEST-A"
        }
      ]
    },
    {
      "ts": 1003,
      "command": {
        "type": "SubmitOrder",
        "order_id": "a0000000-0000-4000-8000-000000000002",
        "asset": "TEST-A",
        "user_id": "U2",
        "side": "BUY",
        "order_type": "LIMIT",
        "tif": "GTC",
        "qty": 1,
        "price": 100
      },
      "expect_reply": {
        "status": "REJECTED",
        "seq": 4,
        "last_seq": 4,
        "engine_epoch": "e-test0001",
        "duplicate": false,
        "order_id": "a0000000-0000-4000-8000-000000000002",
        "code": "ASSET_HALTED"
      },
      "expect_events": [
        {
          "type": "OrderRejected",
          "engine_epoch": "e-test0001",
          "seq": 4,
          "ts": 1003,
          "asset": "TEST-A",
          "order_id": "a0000000-0000-4000-8000-000000000002",
          "user_id": "U2",
          "code": "ASSET_HALTED"
        }
      ]
    },
    {
      "ts": 1004,
      "command": {
        "type": "CancelOrder",
        "order_id": "a0000000-0000-4000-8000-000000000001",
        "reason": "USER"
      },
      "expect_reply": {
        "status": "CANCELED",
        "seq": 5,
        "last_seq": 5,
        "engine_epoch": "e-test0001",
        "duplicate": false,
        "order_id": "a0000000-0000-4000-8000-000000000001",
        "remaining_qty": 5
      },
      "expect_events": [
        {
          "type": "OrderCanceled",
          "engine_epoch": "e-test0001",
          "seq": 5,
          "ts": 1004,
          "asset": "TEST-A",
          "order_id": "a0000000-0000-4000-8000-000000000001",
          "user_id": "U1",
          "filled_qty": 0,
          "remaining_qty": 5,
          "reason": "USER"
        }
      ]
    },
    {
      "ts": 1005,
      "command": {
        "type": "ResumeAsset",
        "asset": "TEST-A"
      },
      "expect_reply": {
        "status": "OK",
        "seq": 6,
        "last_seq": 6,
        "engine_epoch": "e-test0001",
        "duplicate": false,
        "asset": "TEST-A"
      },
      "expect_events": [
        {
          "type": "AssetResumed",
          "engine_epoch": "e-test0001",
          "seq": 6,
          "ts": 1005,
          "asset": "TEST-A"
        }
      ]
    },
    {
      "ts": 1006,
      "command": {
        "type": "SubmitOrder",
        "order_id": "a0000000-0000-4000-8000-000000000003",
        "asset": "TEST-A",
        "user_id": "U2",
        "side": "BUY",
        "order_type": "LIMIT",
        "tif": "GTC",
        "qty": 1,
        "price": 100
      },
      "expect_reply": {
        "status": "ACCEPTED",
        "seq": 7,
        "last_seq": 7,
        "engine_epoch": "e-test0001",
        "duplicate": false,
        "order_id": "a0000000-0000-4000-8000-000000000003"
      },
      "expect_events": [
        {
          "type": "OrderAccepted",
          "engine_epoch": "e-test0001",
          "seq": 7,
          "ts": 1006,
          "asset": "TEST-A",
          "order_id": "a0000000-0000-4000-8000-000000000003",
          "user_id": "U2",
          "side": "BUY",
          "order_type": "LIMIT",
          "tif": "GTC",
          "price": 100,
          "qty": 1
        }
      ],
      "expect_book": {
        "bids": [
          {
            "price": 100,
            "qty": 1,
            "orders": 1
          }
        ],
        "asks": []
      }
    }
  ]
}
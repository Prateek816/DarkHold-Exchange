{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkhold.local/contracts/schemas/book.snapshot.schema.json",
  "title": "BookSnapshot",
  "type": "object",
  "properties": {
    "asset": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{1,32}$"
    },
    "engine_epoch": {
      "type": "string",
      "pattern": "^e-[0-9a-z]{8}$"
    },
    "as_of_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "bids": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "orders": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "price",
          "qty",
          "orders"
        ],
        "additionalProperties": false
      }
    },
    "asks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "orders": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "price",
          "qty",
          "orders"
        ],
        "additionalProperties": false
      }
    },
    "best_bid": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "best_ask": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "spread": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "asset",
    "engine_epoch",
    "as_of_seq",
    "ts",
    "depth",
    "bids",
    "asks",
    "best_bid",
    "best_ask",
    "spread"
  ],
  "additionalProperties": false
}

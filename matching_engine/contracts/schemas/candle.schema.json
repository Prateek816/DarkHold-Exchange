{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkhold.local/contracts/schemas/candle.schema.json",
  "title": "Candle",
  "type": "object",
  "properties": {
    "interval": {
      "type": "string",
      "enum": [
        "5s",
        "1m"
      ]
    },
    "openTime": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "open": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "high": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "low": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "close": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "volume": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tradeCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "string",
      "enum": [
        "ENGINE",
        "SEEDED_SIM"
      ]
    }
  },
  "required": [
    "interval",
    "openTime",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "tradeCount",
    "origin"
  ],
  "additionalProperties": false
}

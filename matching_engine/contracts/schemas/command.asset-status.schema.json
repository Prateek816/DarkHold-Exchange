{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkhold.local/contracts/schemas/command.asset-status.schema.json",
  "title": "AssetStatusCommand",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "HaltAsset",
        "ResumeAsset"
      ]
    },
    "asset": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{1,32}$"
    }
  },
  "required": [
    "type",
    "asset"
  ],
  "additionalProperties": false
}

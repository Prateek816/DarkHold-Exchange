{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkhold.local/contracts/schemas/command.cancel-order.schema.json",
  "title": "CancelOrderCommand",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "CancelOrder"
    },
    "order_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "USER",
        "POLICY_BREACH",
        "ADMIN"
      ]
    }
  },
  "required": [
    "type",
    "order_id",
    "reason"
  ],
  "additionalProperties": false
}

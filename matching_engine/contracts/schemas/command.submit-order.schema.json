{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkhold.local/contracts/schemas/command.submit-order.schema.json",
  "title": "SubmitOrderCommand",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "SubmitOrder"
    },
    "order_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "asset": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{1,32}$"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[\\x21-\\x7E]{1,64}$"
    },
    "side": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "order_type": {
      "type": "string",
      "enum": [
        "LIMIT",
        "MARKET"
      ]
    },
    "tif": {
      "type": "string",
      "enum": [
        "GTC",
        "IOC"
      ]
    },
    "qty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "price": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "type",
    "order_id",
    "asset",
    "user_id",
    "side",
    "order_type",
    "tif",
    "qty",
    "price"
  ],
  "additionalProperties": false
}

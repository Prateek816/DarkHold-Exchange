{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkhold.local/contracts/schemas/health.schema.json",
  "title": "Health",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "down"
      ]
    },
    "engine_epoch": {
      "type": "string",
      "pattern": "^e-[0-9a-z]{8}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uptime_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "status",
    "engine_epoch",
    "seq",
    "uptime_s"
  ],
  "additionalProperties": false
}

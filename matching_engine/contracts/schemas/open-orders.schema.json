{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkhold.local/contracts/schemas/open-orders.schema.json",
  "title": "OpenOrders",
  "type": "object",
  "properties": {
    "engine_epoch": {
      "type": "string",
      "pattern": "^e-[0-9a-z]{8}$"
    },
    "as_of_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "asset": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]{1,32}$"
          },
          "user_id": {
            "type": "string",
            "pattern": "^[\\x21-\\x7E]{1,64}$"
          },
          "side": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "filled_qty": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "remaining_qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "accept_seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "order_id",
          "asset",
          "user_id",
          "side",
          "price",
          "qty",
          "filled_qty",
          "remaining_qty",
          "accept_seq"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "engine_epoch",
    "as_of_seq",
    "orders"
  ],
  "additionalProperties": false
}

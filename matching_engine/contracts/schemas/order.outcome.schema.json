{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkhold.local/contracts/schemas/order.outcome.schema.json",
  "title": "OrderOutcome",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "asset": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{1,32}$"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[\\x21-\\x7E]{1,64}$"
    },
    "side": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "order_type": {
      "type": "string",
      "enum": [
        "LIMIT",
        "MARKET"
      ]
    },
    "tif": {
      "type": "string",
      "enum": [
        "GTC",
        "IOC"
      ]
    },
    "price": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "qty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "filled_qty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remaining_qty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "PARTIALLY_FILLED",
        "FILLED",
        "CANCELED",
        "REJECTED"
      ]
    },
    "reject_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "UNKNOWN_ASSET",
        "ASSET_HALTED",
        "INVALID_QTY",
        "INVALID_PRICE",
        "PRICE_NOT_ON_TICK",
        "PRICE_ABOVE_COLLAR",
        "NOTIONAL_OVERFLOW",
        "INVALID_TIF",
        null
      ]
    },
    "cancel_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "USER",
        "POLICY_BREACH",
        "ADMIN",
        "IOC_REMAINDER",
        "NO_LIQUIDITY",
        "SELF_TRADE_PREVENTED",
        null
      ]
    },
    "first_seq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "engine_epoch": {
      "type": "string",
      "pattern": "^e-[0-9a-z]{8}$"
    },
    "as_of_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "order_id",
    "asset",
    "user_id",
    "side",
    "order_type",
    "tif",
    "price",
    "qty",
    "filled_qty",
    "remaining_qty",
    "status",
    "reject_code",
    "cancel_reason",
    "first_seq",
    "engine_epoch",
    "as_of_seq"
  ],
  "additionalProperties": false
}

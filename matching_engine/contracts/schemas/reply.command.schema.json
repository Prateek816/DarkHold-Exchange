{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkhold.local/contracts/schemas/reply.command.schema.json",
  "title": "CommandReply",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "CANCELED",
        "ALREADY_CANCELED",
        "ALREADY_FILLED",
        "UNKNOWN_ORDER",
        "OK",
        "NOOP"
      ]
    },
    "order_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "asset": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{1,32}$"
    },
    "code": {
      "type": "string",
      "enum": [
        "UNKNOWN_ASSET",
        "ASSET_HALTED",
        "INVALID_QTY",
        "INVALID_PRICE",
        "PRICE_NOT_ON_TICK",
        "PRICE_ABOVE_COLLAR",
        "NOTIONAL_OVERFLOW",
        "INVALID_TIF",
        "ORDER_ID_REUSED",
        "INVALID_CONFIG"
      ]
    },
    "seq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "last_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remaining_qty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "engine_epoch": {
      "type": "string",
      "pattern": "^e-[0-9a-z]{8}$"
    },
    "duplicate": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "seq",
    "last_seq",
    "engine_epoch",
    "duplicate"
  ],
  "additionalProperties": false
}

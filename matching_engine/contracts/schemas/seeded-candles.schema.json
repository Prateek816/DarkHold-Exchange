{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkhold.local/contracts/schemas/seeded-candles.schema.json",
  "title": "SeededCandles",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "seed": {
      "type": "string"
    },
    "end_ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z0-9_-]{1,32}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "reference_price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "candles": {
            "type": "object",
            "properties": {
              "1m": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "interval": {
                      "type": "string",
                      "enum": [
                        "5s",
                        "1m"
                      ]
                    },
                    "openTime": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "open": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "high": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "low": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "close": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "volume": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "tradeCount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "origin": {
                      "type": "string",
                      "enum": [
                        "ENGINE",
                        "SEEDED_SIM"
                      ]
                    }
                  },
                  "required": [
                    "interval",
                    "openTime",
                    "open",
                    "high",
                    "low",
                    "close",
                    "volume",
                    "tradeCount",
                    "origin"
                  ],
                  "additionalProperties": false
                }
              },
              "5s": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "interval": {
                      "type": "string",
                      "enum": [
                        "5s",
                        "1m"
                      ]
                    },
                    "openTime": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "open": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "high": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "low": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "close": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "volume": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "tradeCount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "origin": {
                      "type": "string",
                      "enum": [
                        "ENGINE",
                        "SEEDED_SIM"
                      ]
                    }
                  },
                  "required": [
                    "interval",
                    "openTime",
                    "open",
                    "high",
                    "low",
                    "close",
                    "volume",
                    "tradeCount",
                    "origin"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "1m",
              "5s"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "reference_price",
          "candles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "seed",
    "end_ts",
    "assets"
  ],
  "additionalProperties": false
}
